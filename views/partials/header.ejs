document.addEventListener('DOMContentLoaded', () => {
  const CART_KEY = 'richnixelaroma-cart';

  function getCart() {
    try {
      return JSON.parse(localStorage.getItem(CART_KEY) || '[]');
    } catch (error) {
      return [];
    }
  }

  function saveCart(cart) {
    localStorage.setItem(CART_KEY, JSON.stringify(cart));
  }

  function showToast(message) {
    const existing = document.querySelector('.toast');
    if (existing) existing.remove();
    const toast = document.createElement('div');
    toast.className = 'toast';
    toast.textContent = message;
    document.body.appendChild(toast);
    requestAnimationFrame(() => toast.classList.add('show'));
    setTimeout(() => {
      toast.classList.remove('show');
      setTimeout(() => toast.remove(), 180);
    }, 1800);
  }

  function updateCartBadge() {
    const badge = document.querySelector('[data-cart-count]');
    if (!badge) return;
    const cart = getCart();
    const total = cart.reduce((sum, item) => sum + Number(item.quantity || 0), 0);
    badge.textContent = total;
  }

  function addToCart(product) {
    const cart = getCart();
    const existing = cart.find((item) => item.id === product.id);
    if (existing) existing.quantity += 1;
    else cart.push({ ...product, quantity: 1 });
    saveCart(cart);
    updateCartBadge();
    showToast(`${product.name} added to cart`);

    const target = document.querySelector(`[data-product-id="${product.id}"]`);
    if (target) {
      const original = target.textContent;
      target.textContent = 'Added';
      setTimeout(() => { target.textContent = original; }, 800);
    }
  }

  document.querySelectorAll('[data-add-to-cart]').forEach((button) => {
    button.addEventListener('click', () => addToCart({
      id: button.dataset.productId,
      name: button.dataset.productName,
      price: Number(button.dataset.productPrice || 0),
      image: button.dataset.productImage || '/images/default.jpg',
      slug: button.dataset.productSlug || ''
    }));
  });

  const cartItemsContainer = document.querySelector('[data-cart-items]');
  if (cartItemsContainer) {
    const cart = getCart();
    if (!cart.length) {
      cartItemsContainer.innerHTML = '<p>Your cart is empty. Choose a fragrance to begin.</p>';
      const totalNode = document.querySelector('[data-cart-total]');
      if (totalNode) totalNode.textContent = '₹0';
    } else {
      let subtotal = 0;
      cartItemsContainer.innerHTML = cart.map((item) => {
        const total = Number(item.price || 0) * Number(item.quantity || 1);
        subtotal += total;
        return `
          <div class="cart-item">
            <div class="cart-thumb" aria-hidden="true"></div>
            <div style="flex:1; min-width:0;">
              <strong>${item.name}</strong>
              <div style="color: var(--muted); font-size: 0.8rem;">Qty: ${item.quantity}</div>
            </div>
            <div><strong>₹${total.toLocaleString('en-IN')}</strong></div>
          </div>
        `;
      }).join('');

      const totalNode = document.querySelector('[data-cart-total]');
      if (totalNode) totalNode.textContent = `₹${subtotal.toLocaleString('en-IN')}`;
    }
  }

  const orderSummary = document.querySelector('[data-order-summary]');
  if (orderSummary) {
    const cart = getCart();
    let subtotal = 0;
    orderSummary.innerHTML = cart.length ? cart.map((item) => {
      const total = Number(item.price || 0) * Number(item.quantity || 1);
      subtotal += total;
      return `
        <div class="cart-item">
          <div class="cart-thumb" aria-hidden="true"></div>
          <div style="flex:1; min-width:0;">
            <strong>${item.name}</strong>
            <div style="color: var(--muted); font-size: 0.8rem;">Qty: ${item.quantity}</div>
          </div>
          <div><strong>₹${total.toLocaleString('en-IN')}</strong></div>
        </div>
      `;
    }).join('') : '<p>Your cart is empty.</p>';

    const subtotalNode = document.querySelector('#checkoutSubtotal');
    if (subtotalNode) subtotalNode.textContent = `₹${subtotal.toLocaleString('en-IN')}`;

    const couponInput = document.querySelector('#couponCode');
    const discountNode = document.querySelector('#checkoutDiscount');
    const totalNode = document.querySelector('[data-checkout-total]');
    const hiddenCoupon = document.querySelector('#couponHidden');
    const hiddenTotal = document.querySelector('#checkoutTotal');

    const updateTotals = () => {
      const code = (couponInput ? couponInput.value || '' : '').trim().toUpperCase();
      let discount = 0;
      if (code === 'RICH10') discount = subtotal * 0.10;
      if (code === 'ATTAR20') discount = subtotal * 0.20;
      if (code === 'WELCOME15') discount = subtotal * 0.15;
      const total = Math.max(0, subtotal - discount);
      if (discountNode) discountNode.textContent = `₹${discount.toLocaleString('en-IN')}`;
      if (totalNode) totalNode.textContent = `₹${total.toLocaleString('en-IN')}`;
      if (hiddenCoupon) hiddenCoupon.value = code;
      if (hiddenTotal) hiddenTotal.value = total.toFixed(2);
    };

    if (couponInput) couponInput.addEventListener('input', updateTotals);
    updateTotals();
  }

  const checkoutForm = document.querySelector('#checkoutForm');
  if (checkoutForm) {
    checkoutForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      const cart = getCart();
      if (!cart.length) {
        alert('Your cart is empty.');
        return;
      }

      const formData = new FormData(checkoutForm);
      const payload = {
        name: formData.get('name'),
        phone: formData.get('phone'),
        email: formData.get('email'),
        address: formData.get('address'),
        city: formData.get('city'),
        state: formData.get('state'),
        pincode: formData.get('pincode'),
        paymentMethod: formData.get('paymentMethod'),
        coupon: formData.get('coupon') || '',
        cart
      };

      try {
        const response = await fetch('/api/order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const result = await response.json();
        if (!result.success) {
          alert(result.message || 'Unable to place order.');
          return;
        }

        localStorage.removeItem(CART_KEY);
        updateCartBadge();

        if (payload.paymentMethod === 'upi') {
          window.location.href = result.order.paymentLink || `upi://pay?pa=${encodeURIComponent('Creationlofi777@oksbi')}&pn=${encodeURIComponent('Richnix Perfumes')}&am=0&cu=INR`;
          return;
        }

        window.location.href = `/order-success?orderId=${result.order.id}`;
      } catch (error) {
        alert('Something went wrong while placing your order.');
      }
    });
  }

  updateCartBadge();
});
