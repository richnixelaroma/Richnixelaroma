<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Your cart | <%= config.siteName %></title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <%- include('partials/header') %>
    <main>
      <section class="page-hero"><div class="container"><span class="kicker">Shopping bag</span><h1>Your cart</h1><p>Review your selection and adjust quantities before checkout.</p></div></section>
      <section class="section"><div class="container summary-box cart-page">
        <div data-cart-items aria-live="polite"></div>
        <div class="cart-totals"><div class="total-line"><span>Subtotal</span><strong data-cart-total>₹0</strong></div><p class="muted">Final pricing and coupon discounts are confirmed securely at checkout.</p></div>
        <div class="cart-actions"><a href="/products" class="btn btn-secondary">Continue shopping</a><button type="button" class="btn btn-primary" data-checkout>Continue to checkout</button></div>
      </div></section>
    </main>
    <%- include('partials/footer') %>
    <script type="module" src="/js/app.js"></script>
  </body>
</html>
