<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Checkout | <%= config.siteName %></title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <%- include('partials/header') %>

    <main>
      <section class="page-hero">
        <div class="container">
          <span class="kicker">Secure checkout</span>
          <h1>Complete your order</h1>
        </div>
      </section>

      <section class="section">
        <div class="container checkout-layout">
          <form id="checkoutForm" class="form-area">
            <h3>Delivery details</h3>
            <div class="form-grid">
              <label>
                <span>Name</span>
                <input class="input" type="text" name="name" required />
              </label>
              <label>
                <span>Phone</span>
                <input class="input" type="tel" name="phone" required />
              </label>
              <label style="grid-column: 1 / -1;">
                <span>Email</span>
                <input class="input" type="email" name="email" />
              </label>
              <label style="grid-column: 1 / -1;">
                <span>Address</span>
                <textarea class="textarea" name="address" rows="4" required></textarea>
              </label>
              <label>
                <span>City</span>
                <input class="input" type="text" name="city" required />
              </label>
              <label>
                <span>State</span>
                <input class="input" type="text" name="state" value="Gujarat" required />
              </label>
              <label>
                <span>Pincode</span>
                <input class="input" type="text" name="pincode" required />
              </label>
              <label>
                <span>Coupon code</span>
                <input class="input" type="text" id="couponCode" name="coupon" placeholder="RICH10" />
              </label>
            </div>

            <div style="margin-top: 1.2rem;">
              <h3>Payment method</h3>
              <div class="form-grid">
                <label><input type="radio" name="paymentMethod" value="upi" checked /> Pay via UPI</label>
                <label><input type="radio" name="paymentMethod" value="cod" /> Cash on delivery</label>
              </div>
            </div>

            <input type="hidden" id="couponHidden" name="coupon" />
            <input type="hidden" id="checkoutTotal" />
            <button class="btn btn-primary" style="margin-top: 1rem;" type="submit">Place order</button>
          </form>

          <aside class="summary-box">
            <h3>Order summary</h3>
            <div data-order-summary></div>
            <div class="cart-totals">
              <div class="total-line"><span>Subtotal</span><span id="checkoutSubtotal">₹0</span></div>
              <div class="total-line"><span>Discount</span><span id="checkoutDiscount">₹0</span></div>
              <div class="total-line"><strong>Total</strong><strong data-checkout-total>₹0</strong></div>
            </div>
          </aside>
        </div>
      </section>
    </main>

    <%- include('partials/footer') %>
    <script src="/js/app.js"></script>
  </body>
</html>
