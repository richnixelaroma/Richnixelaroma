<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Support | <%= config.siteName %></title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <%- include('partials/header') %>

    <main>
      <section class="page-hero">
        <div class="container">
          <span class="kicker">Customer care</span>
          <h1>We’re here to help</h1>
        </div>
      </section>

      <section class="section">
        <div class="container support-grid" style="display:grid; grid-template-columns: 1fr 1fr; gap:1.2rem;">
          <div class="mini-card">
            <h3>Speak with our team</h3>
            <p>Need order help, fragrance suggestions, or shipping information? We are available to assist.</p>
            <div class="status-pill" style="display:inline-block; margin-top:0.8rem; padding:0.4rem 0.7rem; border-radius:999px; background:rgba(216,177,122,0.1); color:var(--gold); border:1px solid var(--line); text-transform:uppercase; font-size:0.7rem; letter-spacing:0.1rem;">Daily support</div>
            <p style="margin-top:1rem; font-size:1.3rem; font-weight:700; color:var(--gold);"><%= config.supportPhone %></p>
            <div class="hero-actions" style="margin-top:1rem;">
              <a href="tel:+919099401987" class="btn btn-primary">Call now</a>
              <a href="mailto:support@richnixelaroma.com" class="btn btn-secondary">Email us</a>
            </div>
          </div>

          <div class="mini-card">
            <h3>Support policies</h3>
            <ul class="list">
              <li>• Orders accepted within Gujarat</li>
              <li>• UPI payment via Creationlofi777@oksbi</li>
              <li>• COD available for eligible Gujarat addresses</li>
              <li>• Order help within 24 hours</li>
            </ul>
          </div>
        </div>
      </section>
    </main>

    <%- include('partials/footer') %>
  </body>
</html>
