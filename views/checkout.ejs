<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Your Cart | <%= config.siteName %></title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <%- include('partials/header') %>

    <main>
      <section class="page-hero">
        <div class="container">
          <span class="kicker">Shopping cart</span>
          <h1>Your selection</h1>
        </div>
      </section>

      <section class="section">
        <div class="container summary-box" style="max-width: 920px;">
          <div data-cart-items></div>
          <div class="cart-totals">
            <div class="total-line">
              <span>Subtotal</span>
              <strong data-cart-total>₹0</strong>
            </div>
          </div>
          <div style="margin-top: 1rem; display: flex; justify-content: flex-end;">
            <button class="btn btn-primary" data-checkout>Proceed to checkout</button>
          </div>
        </div>
      </section>
    </main>

    <%- include('partials/footer') %>
    <script src="/js/app.js"></script>
    <script>
      document.querySelector('[data-checkout]').addEventListener('click', () => {
        window.location.href = '/checkout';
      });
    </script>
  </body>
</html>
